{
  "name": "@ston-rewards/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "ston-rewards": "./dist/decode.js" },
  "scripts": {
    "build": "tsup src/decode.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "decode": "node --experimental-strip-types src/decode.ts"
  },
  "dependencies": {
    "@ston-rewards/core-types": "workspace:*",
    "@ston-rewards/data-provider": "workspace:*",
    "@ston-rewards/decoder": "workspace:*"
  }
}
