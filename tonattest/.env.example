# ── Required ────────────────────────────────────────────────────────────────
# Postgres. Durable state: campaigns, the verification log that makes
# idempotency work, the attestation audit trail, and the activity cache whose
# tx_hash UNIQUE constraint is the replay guard.
DATABASE_URL=postgres://user:password@host:5432/tonattest

# Redis. Ephemeral coordination: per-project rate limits, the wallet freshness
# marker, and the single-flight lock that stops concurrent claims from
# stampeding the upstream data provider.
REDIS_URL=rediss://default:password@host:6379

# Encrypts project signing keys at rest (AES-256-GCM). 32 bytes, hex-encoded.
# Generate with: openssl rand -hex 32
# Losing this makes every stored signing key unrecoverable; leaking it makes
# every attestation forgeable. It never belongs in the database.
MASTER_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Raises the tonapi rate limit. Without it the public tier applies.
TONAPI_KEY=

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# How long a wallet's cached activity stays fresh before a re-fetch, seconds.
ACTIVITY_TTL_SECONDS=60

# Per-project request budget: tokens, and refill per second.
RATE_LIMIT_BURST=60
RATE_LIMIT_PER_SECOND=10

# Hard cap on events fetched per wallet. Exceeding it fails closed rather than
# evaluating against a partial history.
MAX_EVENTS_PER_WALLET=1000
